# 环境变量模板（复制为 .env 后按需修改）
# 用法: cp .env.example .env && 编辑 .env && docker compose up -d --build

# MySQL root 密码（生产必须修改；compose 首次启动生效，改后需重建 mysql 卷）
DB_PASSWORD=homework123456

# JWT 签名密钥（生产必须修改，长度建议 ≥32 字符；更换后所有已登录会话失效）
JWT_SECRET=change-me-before-production-2026

# AI 出题（DeepSeek，可选——不配置则题库页"AI 生成"报"AI 服务未配置"）
DEEPSEEK_API_KEY=

# QQ 邮箱授权码（可选——不配置则注册页"获取验证码"发信失败；需配合 spring.mail.username）
MAIL_AUTH_CODE=
